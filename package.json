{
  "name": "documind",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @documind/web dev",
    "build": "pnpm --filter @documind/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @documind/db generate",
    "db:migrate": "pnpm --filter @documind/db migrate",
    "db:push": "pnpm --filter @documind/db push"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}

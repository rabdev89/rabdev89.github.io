# =============================================================================
# DocuMind Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# See README.md "Environment Variables" section for where to get each value.
# =============================================================================

# --- Clerk Authentication ---
# Get these from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXX
CLERK_SECRET_KEY=sk_test_XXXX

# Clerk route paths (no need to change these)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Cloud SQL PostgreSQL) ---
# Local dev: postgresql://USER:PASSWORD@localhost:5432/documind
# Production: postgresql://documind:PASSWORD@/documind?host=/cloudsql/PROJECT:REGION:documind-db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind

# --- AWS (S3 uploads) ---
# Region where you deployed the CDK stack
AWS_REGION=us-east-1
# Create an IAM user with S3 access, or use IAM roles in production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# From CDK deploy output: UploadBucketName
S3_UPLOAD_BUCKET=documind-uploads

# --- GCP ---
# From: gcloud config get-value project
GCP_PROJECT_ID=
# Must match infra/gcp deployment region
GCP_REGION=us-central1

# --- Google AI / ADK ---
# Get from: https://aistudio.google.com/apikey → Create API Key
GOOGLE_API_KEY=

# --- Agent Service ---
# Local dev: http://localhost:8001
# Production: terraform output cloud_run_url (from infra/gcp)
AGENT_SERVICE_URL=http://localhost:8001

# --- Vertex AI Vector Search ---
# From: terraform output vector_search_endpoint_id
# Format: projects/PROJECT_NUM/locations/REGION/indexEndpoints/ENDPOINT_ID
VERTEX_VECTOR_SEARCH_INDEX_ENDPOINT=
# From: GCP Console → Vertex AI → Vector Search → endpoint → Deployed Index ID
VERTEX_VECTOR_SEARCH_DEPLOYED_INDEX_ID=

# --- Agent tuning (optional) ---
# LLM model for all agents (default: gemini-2.0-flash)
# LLM_MODEL=gemini-2.0-flash
# Embedding model (default: text-embedding-005) — do NOT change after index creation
# EMBEDDING_MODEL=text-embedding-005
# Embedding dimensions — must match Vector Search index (default: 768)
# EMBEDDING_DIMENSIONS=768
# Max Writer↔Critic revision loops (default: 2)
# MAX_CRITIC_REVISIONS=2
# Max Coder↔Reviewer revision loops (default: 2)
# MAX_CODE_REVIEW_ROUNDS=2

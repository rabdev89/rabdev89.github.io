# Shopify App
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=write_payment_gateways,write_payment_sessions

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/altpaynet_shopify

# Encryption key for stored credentials (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# App URL (your deployed domain)
APP_URL=https://your-app-domain.com
